package io.github.greenisus1.shipwheel;

import org.bukkit.*;
import org.bukkit.block.Block;
import org.bukkit.block.BlockFace;
import org.bukkit.block.BlockState;
import org.bukkit.block.TileState;
import org.bukkit.block.data.*;

import java.util.*;

record Cell(int dx, int dy, int dz, BlockData data) {}

/** Structure snapshot: everything connected to a wheel that is not natural terrain or a container. */
class Vehicle {
    static final int MAX_BLOCKS = 4000;
    ShipWheelPlugin pl; World world; int px, py, pz; BlockFace heading; List<Cell> cells = new ArrayList<>();

        static final Set<Material> TERRAIN = EnumSet.of(Material.STONE, Material.DIRT, Material.GRASS_BLOCK, Material.SAND,
                Material.GRAVEL, Material.COARSE_DIRT, Material.PODZOL, Material.MYCELIUM, Material.DEEPSLATE, Material.BEDROCK,
                Material.NETHERRACK, Material.SANDSTONE, Material.RED_SAND, Material.CLAY, Material.SNOW_BLOCK, Material.ICE,
                Material.GRANITE, Material.DIORITE, Material.ANDESITE, Material.TUFF, Material.DIRT_PATH, Material.ROOTED_DIRT,
                Material.MUD, Material.TERRACOTTA, Material.WATER, Material.LAVA, Material.SMOOTH_STONE, Material.POLISHED_ANDESITE, Material.AIR, Material.CAVE_AIR, Material.VOID_AIR);

        static boolean part(Block b, Block wheel) {
            Material m = b.getType();
            if (TERRAIN.contains(m) || m.isAir() || b.isLiquid()) return false;
            if (b.getLocation().equals(wheel.getLocation())) return true;
            BlockState st = b.getState(false);
            return !(st instanceof TileState); // chests, furnaces etc. stay put so items are never lost
        }

        static Vehicle assemble(ShipWheelPlugin pl, Block wheel, BlockFace heading) {
            Vehicle v = new Vehicle();
            v.pl = pl; v.world = wheel.getWorld(); v.px = wheel.getX(); v.py = wheel.getY(); v.pz = wheel.getZ(); v.heading = heading;
            Set<Long> seen = new HashSet<>(); Deque<Block> q = new ArrayDeque<>(); q.add(wheel);
            seen.add(pack(wheel.getX(), wheel.getY(), wheel.getZ()));
            BlockFace[] fs = {BlockFace.UP, BlockFace.DOWN, BlockFace.NORTH, BlockFace.SOUTH, BlockFace.EAST, BlockFace.WEST};
            while (!q.isEmpty() && v.cells.size() < MAX_BLOCKS) {
                Block b = q.poll();
                v.cells.add(new Cell(b.getX() - v.px, b.getY() - v.py, b.getZ() - v.pz, b.getBlockData().clone()));
                for (BlockFace f : fs) {
                    Block n = b.getRelative(f);
                    long k = pack(n.getX(), n.getY(), n.getZ());
                    if (seen.add(k) && part(n, wheel)) q.add(n);
                }
            }
            return v.cells.size() > 1 ? v : null;
        }

        static long pack(int x, int y, int z) { return (((long) x & 0x3FFFFFF) << 38) | (((long) z & 0x3FFFFFF) << 12) | ((long) y & 0xFFF); }

        boolean freeAt(int x, int y, int z, Set<Long> own) {
            if (own.contains(pack(x, y, z))) return true;
            if (y < world.getMinHeight() || y >= world.getMaxHeight()) return false;
            Block b = world.getBlockAt(x, y, z);
            return b.isEmpty() || b.isLiquid() || b.isPassable() && !(b.getState(false) instanceof TileState);
        }

        static BlockData rot(BlockData bd, boolean cw) {
            BlockData n = bd.clone();
            if (n instanceof Directional di) {
                BlockFace f = di.getFacing();
                if (f != BlockFace.UP && f != BlockFace.DOWN) di.setFacing(cw ? rotCw(f) : rotCcw(f));
            }
            if (n instanceof Rotatable ro) ro.setRotation(cw ? rotCw(ro.getRotation()) : rotCcw(ro.getRotation()));
            if (n instanceof Orientable or) { if (or.getAxis() == Axis.X) or.setAxis(Axis.Z); else if (or.getAxis() == Axis.Z) or.setAxis(Axis.X); }
            if (n instanceof MultipleFacing mf) {
                Map<BlockFace, Boolean> old = new HashMap<>();
                for (BlockFace f : mf.getAllowedFaces()) old.put(f, mf.hasFace(f));
                for (BlockFace f : mf.getAllowedFaces()) if (f.getModY() == 0) mf.setFace(f, old.getOrDefault(cw ? rotCcw(f) : rotCw(f), false));
            }
            return n;
        }

        static BlockFace rotCw(BlockFace f) {
            return switch (f) { case NORTH -> BlockFace.EAST; case EAST -> BlockFace.SOUTH; case SOUTH -> BlockFace.WEST; case WEST -> BlockFace.NORTH;
                case NORTH_NORTH_EAST -> BlockFace.EAST_NORTH_EAST; case NORTH_EAST -> BlockFace.EAST_SOUTH_EAST; case EAST_NORTH_EAST -> BlockFace.EAST_SOUTH_EAST;
                case EAST_SOUTH_EAST -> BlockFace.SOUTH_SOUTH_EAST; case SOUTH_EAST -> BlockFace.SOUTH_SOUTH_WEST; case SOUTH_SOUTH_EAST -> BlockFace.SOUTH_WEST;
                case SOUTH_SOUTH_WEST -> BlockFace.WEST_SOUTH_WEST; case SOUTH_WEST -> BlockFace.WEST_NORTH_WEST; case WEST_SOUTH_WEST -> BlockFace.NORTH_WEST;
                case WEST_NORTH_WEST -> BlockFace.NORTH_NORTH_WEST; case NORTH_WEST -> BlockFace.NORTH_NORTH_EAST; case NORTH_NORTH_WEST -> BlockFace.NORTH_EAST;
                default -> f; };
        }
        static BlockFace rotCcw(BlockFace f) { BlockFace r = f; for (int i = 0; i < 3; i++) r = rotCw(r); return r; }

}v
